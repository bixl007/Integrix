# Copy to .env and fill in. Docker Compose and the local dev scripts both read this file.

# Database (docker compose exposes Postgres on 5433)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/integrix

# Kafka broker
KAFKA_BROKER=localhost:9092

# Public URLs: web app (CORS, OAuth redirects) and API (OAuth callback base)
WEB_URL=http://localhost:3001
API_PUBLIC_URL=http://localhost:3000

# Google sign-in (optional; the button appears only when both values are set)
# Google callback: http://localhost:3000/api/v1/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Service ports
API_PORT=3000
HOOKS_PORT=3002

# Frontend (inlined at build time)
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_HOOKS_URL=http://localhost:3002

# Solana sender secret key (base58, devnet): the server wallet, used by steps without their own connection
SOL_PRIVATE_KEY=

# Key for encrypting users' saved connections (their Gmail app password, their Solana key).
# Generate once with: openssl rand -hex 32. Changing it makes saved connections unreadable.
CONNECTION_SECRET=

# SMTP via Gmail: SMTP_USERNAME and FROM_EMAIL = your Gmail address, SMTP_PASSWORD = 16-char App Password (no spaces)
SMTP_ENDPOINT=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
FROM_EMAIL=
