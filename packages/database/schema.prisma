// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int       @id @default(autoincrement())
  name          String
  email         String    @unique
  /// Null for accounts created through OAuth only.
  password      String?
  emailVerified Boolean   @default(false)
  createdAt     DateTime  @default(now())
  zaps          Zap[]
  sessions      Session[]
  otpCodes      OtpCode[]
}

/// Server-side login session; the cookie holds the raw token, only its SHA-256 is stored.
model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

/// One-time email code for signup/login or for confirming a new email address.
model OtpCode {
  id        String   @id @default(uuid())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "auth" (signup/login) or "email_change"; a code only works for its own purpose.
  purpose   String   @default("auth")
  /// Target address for "email_change"; null for "auth".
  email     String?
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Zap {
  id        String   @id @default(uuid())
  /// Custom title; null shows the "Trigger → Action" title.
  name      String?
  /// False turns the zap off: hooks refuses new runs.
  enabled   Boolean  @default(true)
  triggerId String
  userId    Int
  trigger   Trigger?
  actions   Action[]
  zapRuuns  ZapRun[]
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

model Trigger {
  id        String           @id @default(uuid())
  zapId     String           @unique
  triggerId String
  type      AvailableTrigger @relation(fields: [triggerId], references: [id])
  zap       Zap              @relation(fields: [zapId], references: [id], onDelete: Cascade)
}

model Action {
  id           String          @id @default(uuid())
  zapId        String
  zap          Zap             @relation(fields: [zapId], references: [id], onDelete: Cascade)
  actionId     String
  type         AvailableAction @relation(fields: [actionId], references: [id])
  sortingOrder Int             @default(0)
  metadata     Json?           @default("{}")
}

model AvailableAction {
  id      String   @id @default(uuid())
  name    String
  image   String
  actions Action[]
}

model AvailableTrigger {
  id       String    @id @default(uuid())
  name     String
  image    String
  triggers Trigger[]
}

model ZapRun {
  id           String        @id @default(uuid())
  zapId        String
  metadata     Json
  /// "queued", "running", "success", "failed" or "halted"; "unknown" marks runs from before run history.
  status       String        @default("queued")
  createdAt    DateTime      @default(now())
  finishedAt   DateTime?
  /// The zap's steps when the run started (RunAction[]); null on runs from before step snapshots.
  actions      Json?
  zap          Zap           @relation(fields: [zapId], references: [id], onDelete: Cascade)
  zapRunOutbox ZapRunOutbox?
  steps        ZapRunStep[]

  @@index([zapId, createdAt])
}

/// A stage waiting to be published to Kafka; a run has at most one pending stage.
model ZapRunOutbox {
  id          String   @id @default(uuid())
  zapRunId    String   @unique
  stage       Int      @default(0)
  /// The processor publishes the row once this time has passed.
  availableAt DateTime @default(now())
  zapRun      ZapRun   @relation(fields: [zapRunId], references: [id], onDelete: Cascade)

  @@index([availableAt])
}

/// The recorded result of one stage of a run, written by the worker.
model ZapRunStep {
  id         String   @id @default(uuid())
  zapRunId   String
  zapRun     ZapRun   @relation(fields: [zapRunId], references: [id], onDelete: Cascade)
  stage      Int
  /// AvailableAction id that ran, kept as text so history survives step edits.
  actionId   String
  /// "success", "failed", "halted" or "skipped" (no handler registered).
  status     String
  error      String?
  output     Json?
  startedAt  DateTime
  finishedAt DateTime

  @@unique([zapRunId, stage])
}
